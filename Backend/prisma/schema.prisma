// ==============================================
// PRISMA SCHEMA - Tailor Management System
// ==============================================
// Learn more: https://pris.ly/d/prisma-schema
// ==============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/////////////////////////////
// ENUMS
/////////////////////////////

enum OrderStatus {
  pending
  inProgress
  completed
  readyToDeliver
}

enum ItemStatusType {
  pending
  cutting
  redayToStich
  stitching
  readyToFinishing
  finishing
  readyToDeliver
}

enum Role {
  superAdmin
  admin
  subAdmin
}

/////////////////////////////
// USER MANAGEMENT
/////////////////////////////

model User {
  userId    String    @id
  fullName  String
  emailId   String    @unique
  password  String
  role      Role
  isDeleted Boolean   @default(false)
  updatedBy String?
  updatedAt DateTime? @updatedAt
  createdAt DateTime  @default(now())
  needToResetPassword Boolean @default(true)

  updater            User?               @relation("UserUpdater", fields: [updatedBy], references: [userId], onUpdate: Cascade, onDelete: SetNull)
  updatedUsers       User[]              @relation("UserUpdater")
  createdCustomers   Customer[]          @relation("CustomerCreator")
  updatedCustomers   Customer[]          @relation("CustomerUpdater")
  topMeasurements    TopMeasurement[]
  bottomMeasurements BottomMeasurement[]

  // Cloth management relations
  updatedStages       WorkStage[]      @relation("UserStageUpdates")
  assignedWorkPieces  OrderWorkPiece[]
  updatedItemStatuses ItemStatus[]     @relation("UserItemStatusUpdates")
}

/////////////////////////////
// CUSTOMER & MEASUREMENT
/////////////////////////////

model Customer {
  customerId          String    @id
  fullName            String
  emailId             String
  mobileNo            String
  address             String
  reference           String?
  isDeleted           Boolean   @default(false)
  createdBy           String?
  updatedBy           String?
  updatedAt           DateTime? @updatedAt
  createdAt           DateTime  @default(now())
  topMeasurementId    String?
  bottomMeasurementId String?

  creator           User?              @relation("CustomerCreator", fields: [createdBy], references: [userId], onUpdate: Cascade, onDelete: SetNull)
  updater           User?              @relation("CustomerUpdater", fields: [updatedBy], references: [userId], onUpdate: Cascade, onDelete: SetNull)
  topMeasurement    TopMeasurement?    @relation(fields: [topMeasurementId], references: [topMeasurementId], onUpdate: Cascade, onDelete: SetNull)
  bottomMeasurement BottomMeasurement? @relation(fields: [bottomMeasurementId], references: [bottomMeasurementId], onUpdate: Cascade, onDelete: SetNull)

  // Cloth management relation
  orders ProductOrder[]
}

model TopMeasurement {
  topMeasurementId String    @id
  length           Decimal   @db.Decimal(10, 2)
  shoulder         Decimal   @db.Decimal(10, 2)
  sleeveLength     Decimal   @db.Decimal(10, 2)
  sleeveBottom     Decimal   @db.Decimal(10, 2)
  chest            Decimal   @db.Decimal(10, 2)
  waist            Decimal   @db.Decimal(10, 2)
  hip              Decimal   @db.Decimal(10, 2)
  neck             Decimal   @db.Decimal(10, 2)
  isDeleted        Boolean   @default(false)
  updatedBy        String?
  updatedAt        DateTime? @updatedAt
  createdAt        DateTime  @default(now())

  updater   User?      @relation(fields: [updatedBy], references: [userId], onUpdate: Cascade, onDelete: SetNull)
  customers Customer[]
}

model BottomMeasurement {
  bottomMeasurementId String    @id
  length              Decimal   @db.Decimal(10, 2)
  waist               Decimal   @db.Decimal(10, 2)
  hip                 Decimal   @db.Decimal(10, 2)
  thigh               Decimal   @db.Decimal(10, 2)
  knee                Decimal   @db.Decimal(10, 2)
  calf                Decimal   @db.Decimal(10, 2)
  bottom              Decimal   @db.Decimal(10, 2)
  langot              Decimal   @db.Decimal(10, 2)
  isDeleted           Boolean   @default(false)
  updatedBy           String?
  updatedAt           DateTime? @updatedAt
  createdAt           DateTime  @default(now())

  updater   User?      @relation(fields: [updatedBy], references: [userId], onUpdate: Cascade, onDelete: SetNull)
  customers Customer[]
}

/////////////////////////////
// PRODUCT MANAGEMENT
/////////////////////////////

// 3️⃣ PRODUCT ITEMS — Pant, Shirt, Blazer, etc.
model ProductItem {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String?
  createdAt DateTime @default(now())

  itemStatuses ItemStatus[]
  workPieces   OrderWorkPiece[]
  variants     ProductVariant[]
}

// 4️⃣ PRODUCTS — Suit, Sherwani, Indowestern, etc.
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  variants ProductVariant[]
}

// 5️⃣ PRODUCT VARIANTS — Normal / 2-piece / 3-piece
model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  name        String
  description String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productItems ProductItem[]
  orderItems   OrderItem[]
}

/////////////////////////////
// ORDER MANAGEMENT
/////////////////////////////

// 6️⃣ PRODUCT ORDERS — A customer's overall order
model ProductOrder {
  id           String      @id @default(uuid())
  customerId   String
  orderDate    DateTime    @default(now())
  deliveryDate DateTime?
  notes        String?
  status       OrderStatus @default(pending)
  totalAmount  Decimal?    @db.Decimal(10, 2)
  isDeleted    Boolean     @default(false)

  customer   Customer    @relation(fields: [customerId], references: [customerId], onDelete: Cascade, onUpdate: Cascade)
  orderItems OrderItem[]
}

// 7️⃣ ORDER ITEMS — Each product variant in an order
model OrderItem {
  id               String   @id @default(uuid())
  productOrderId   String
  productVariantId String
  quantity         Int      @default(1)
  notes            String?
  createdAt        DateTime @default(now())

  productOrder   ProductOrder   @relation(fields: [productOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  workPieces   OrderWorkPiece[]
  itemStatuses ItemStatus[]
}

// 8️⃣ ORDER WORK PIECE — Individual part of a product (Pant, Shirt, Blazer)
model OrderWorkPiece {
  id            String         @id @default(uuid())
  orderItemId   String
  productItemId String
  assignedToId  String?
  currentStatus ItemStatusType @default(cutting)
  remarks       String?
  createdAt     DateTime       @default(now())

  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productItem ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignedTo  User?       @relation(fields: [assignedToId], references: [userId], onDelete: SetNull, onUpdate: Cascade)

  workStages WorkStage[]
}

// 9️⃣ WORK STAGE — Tracks status updates (cutting, stitching, finishing)
model WorkStage {
  id               String         @id @default(uuid())
  orderWorkPieceId String
  stage            ItemStatusType
  startedAt        DateTime?
  completedAt      DateTime?
  updatedById      String?
  remarks          String?

  orderWorkPiece OrderWorkPiece @relation(fields: [orderWorkPieceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedBy      User?          @relation("UserStageUpdates", fields: [updatedById], references: [userId], onDelete: SetNull, onUpdate: Cascade)
}

model ItemStatus {
  id            String         @id @default(uuid())
  orderItemId   String
  productItemId String
  status        ItemStatusType
  updatedById   String?
  updatedAt     DateTime       @default(now())
  remarks       String?

  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  productItem ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updatedBy   User?       @relation("UserItemStatusUpdates", fields: [updatedById], references: [userId], onDelete: SetNull, onUpdate: Cascade)
}
