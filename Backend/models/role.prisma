model Role {
  roleId    String   @id
  roleName  String
  isDeleted Boolean  @default(false)
  updatedBy String?
  updatedAt DateTime? @updatedAt
  createdAt DateTime @default(now())

  users     User[]
  customers Customer[]
  updater   User?    @relation(fields: [updatedBy], references: [userId], onUpdate: Cascade, onDelete: SetNull)
}


